PORT=3004

# ── Supabase (same project as course-web) ────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── The web app's URL ──────────────────────────────────────────────
# Must point at your course-web deployment's URL.
KURSO_URL=https://your-domain.example

# ── Shared secret with course-web and Whatsapp-bot — same value everywhere ──
INTERNAL_BOT_SECRET=

# ── Signed-link secrets — must match course-web's values exactly ──
LESSON_LINK_SECRET=
TELEGRAM_LINK_SECRET=
WHATSAPP_LINK_SECRET=

# ── Telegram ───────────────────────────────────────────────────────
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# A string you choose yourself, used to verify inbound webhook calls.
TELEGRAM_WEBHOOK_SECRET=