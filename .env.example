PORT=3002

# ── Supabase (same project as course-web) ────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── The web app's URL ──────────────────────────────────────────────
# Must point at your course-web deployment's URL.
KURSO_URL=https://www.kurso.in

# ── Shared secret with course-web and Whatsapp-bot — same value everywhere ──
INTERNAL_BOT_SECRET=

# ── Signed-link secrets ────────────────────────────────────────────
# IMPORTANT: set all three to the exact SAME value as course-web's,
# and the same value as Whatsapp-bot's LESSON_LINK_SECRET /
# WHATSAPP_LINK_SECRET too — one shared secret across all three
# services. This repo checks LESSON_LINK_SECRET first (Whatsapp-bot
# checks WHATSAPP_LINK_SECRET first) — if they're ever set to
# different values, a link signed by one bot will fail verification
# on the website. Keeping every copy identical makes that ordering
# difference harmless.
LESSON_LINK_SECRET=
TELEGRAM_LINK_SECRET=
WHATSAPP_LINK_SECRET=

# ── Telegram ───────────────────────────────────────────────────────
# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# A random string you generate yourself (openssl rand -hex 32 works well,
# 32–64 chars) — Telegram allows only letters, numbers, underscores, and
# hyphens here. Must also be passed to Telegram's setWebhook call, see
# SETUP.md — setting it here alone isn't enough.
TELEGRAM_WEBHOOK_SECRET=